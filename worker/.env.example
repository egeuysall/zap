WORKER_API_BASE_URL=https://your-convex-site.convex.site
WORKER_TOKEN=replace-with-shared-worker-token
WORKER_ID=downloader-local
WORKER_POLL_MS=5000
WORKER_JOB_TIMEOUT_MS=1200000
YT_DLP_BIN=yt-dlp
FFPROBE_BIN=ffprobe

# Optional Redis Streams queue. Convex HTTP is used unless WORKER_QUEUE=redis.
WORKER_QUEUE=convex
REDIS_URL=redis://localhost:6379
REDIS_JOBS_STREAM=zap:downloads
REDIS_EVENTS_STREAM=zap:download-events
REDIS_GROUP=downloaders
